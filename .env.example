# [Local 환경]
# 로컬 개발 시에는 Docker Compose가 자동으로 DB를 띄우고
# 접속 정보를 주입하므로 아래 RDS/MONGO 변수를 비워두셔도 정상 동작합니다.
# [Prod 환경 (운영)]
# 운영(AWS) 배포 시에는 AWS Parameter Store에
# 반드시 아래 변수명으로 접속 정보를 세팅해야 합니다.
RDS_ENDPOINT=
RDS_USERNAME=
RDS_PASSWORD=
# 데이터베이스 이름(/monew)을 URI 경로에 포함해야 합니다.
# 예: mongodb+srv://<username>:<password>@<cluster>/monew?retryWrites=true&w=majority
MONGO_URI=

# 외부 연동 (#36, #40)
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
AWS_REGION=ap-northeast-2
AWS_S3_BUCKET=
