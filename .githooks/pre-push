#!/bin/sh
# push 전 전체 빌드(포맷 검사·컴파일·테스트)를 돌려 CI에서 깨질 코드가 올라가지 않게 한다.
# 긴급 시 git push --no-verify 로 건너뛸 수 있다. (CI는 그대로 검사)

# 브랜치 삭제 push는 검사하지 않는다.
ZERO=0000000000000000000000000000000000000000
HAS_UPDATE=0
while read -r LOCAL_REF LOCAL_SHA REMOTE_REF REMOTE_SHA; do
  [ "$LOCAL_SHA" != "$ZERO" ] && HAS_UPDATE=1
done
[ "$HAS_UPDATE" -eq 0 ] && exit 0

# 통합 테스트(Testcontainers)는 Docker가 필요하다.
if ! docker info >/dev/null 2>&1; then
  echo ""
  echo "❌ [pre-push] Docker가 실행 중이 아닙니다. Docker Desktop을 켠 뒤 다시 push하세요."
  echo ""
  exit 1
fi

echo "[pre-push] ./gradlew build 실행 중... (1~2분)"
if ! ./gradlew build -q; then
  echo ""
  echo "❌ [pre-push] 빌드 또는 테스트가 실패해 push를 중단합니다."
  echo "   포맷 오류: ./gradlew spotlessApply"
  echo "   테스트 리포트: build/reports/tests/test/index.html"
  echo ""
  exit 1
fi
exit 0
